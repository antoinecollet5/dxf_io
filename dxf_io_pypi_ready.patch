diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..8af6004
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,217 @@
+name: Release
+
+# Pushing a tag `vX.Y.Z` builds the sdist and the wheels of every platform, tests the
+# wheels, publishes everything to PyPI and creates a GitHub release.
+# Running the workflow manually builds and tests everything without publishing.
+
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: false
+
+env:
+  CARGO_TERM_COLOR: always
+  UV_NO_PROGRESS: 1
+  # CPython versions a wheel is built for ("t": free-threaded build).
+  PYTHONS: "3.10 3.11 3.12 3.13 3.14 3.14t 3.15 3.15t"
+
+jobs:
+  sdist:
+    name: Source distribution
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Check that the tag matches the version in Cargo.toml
+        if: startsWith(github.ref, 'refs/tags/')
+        run: |
+          version=$(grep -m1 '^version' Cargo.toml | cut -d '"' -f2)
+          if [ "${GITHUB_REF_NAME}" != "v${version}" ]; then
+            echo "::error::Tag ${GITHUB_REF_NAME} does not match Cargo.toml version ${version}"
+            exit 1
+          fi
+
+      - uses: PyO3/maturin-action@e83996d129638aa358a18fbd1dfb82f0b0fb5d3b # v1.51.0
+        with:
+          command: sdist
+          args: --out dist
+
+      - uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
+
+      - name: Build from the sdist and test
+        run: |
+          uv venv --managed-python --python 3.13
+          uv pip install --only-binary numpy pytest dist/*.tar.gz
+          mkdir sdist-test && tar -xzf dist/*.tar.gz -C sdist-test --strip-components=1
+          cd sdist-test && ../.venv/bin/python -m pytest -q -p no:cacheprovider
+
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: dist-sdist
+          path: dist
+
+  linux:
+    name: Wheels linux-${{ matrix.target }}-${{ matrix.libc }}
+    runs-on: ${{ matrix.runner }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { runner: ubuntu-24.04, target: x86_64, libc: gnu, manylinux: auto }
+          - { runner: ubuntu-24.04-arm, target: aarch64, libc: gnu, manylinux: auto }
+          - { runner: ubuntu-24.04, target: x86_64, libc: musl, manylinux: musllinux_1_2 }
+          - { runner: ubuntu-24.04-arm, target: aarch64, libc: musl, manylinux: musllinux_1_2 }
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: List the interpreters
+        run: echo "INTERPRETERS=$(printf 'python%s ' $PYTHONS)" >> "$GITHUB_ENV"
+
+      - uses: PyO3/maturin-action@e83996d129638aa358a18fbd1dfb82f0b0fb5d3b # v1.51.0
+        with:
+          target: ${{ matrix.target }}
+          manylinux: ${{ matrix.manylinux }}
+          args: --release --out dist --interpreter ${{ env.INTERPRETERS }}
+
+      - uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
+        if: matrix.libc == 'gnu'
+
+      - name: Test the wheels (every Python version)
+        if: matrix.libc == 'gnu'
+        run: bash .github/scripts/test-wheels.sh
+
+      - name: Test the wheels (musl, Alpine)
+        if: matrix.libc == 'musl'
+        run: |
+          docker run --rm -v "$PWD:/io" -w /io python:3.14-alpine sh -euc '
+            pip install --root-user-action=ignore -q --only-binary=:all: numpy pytest
+            pip install --root-user-action=ignore -q --no-index --no-deps --find-links dist dxf_io
+            python -m pytest -q -p no:cacheprovider tests'
+
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: dist-linux-${{ matrix.target }}-${{ matrix.libc }}
+          path: dist
+
+  macos-windows:
+    name: Wheels ${{ matrix.platform }}-${{ matrix.target }}
+    runs-on: ${{ matrix.runner }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { runner: macos-15-intel, platform: macos, target: x86_64 }
+          - { runner: macos-latest, platform: macos, target: aarch64 }
+          - { runner: windows-latest, platform: windows, target: x64 }
+          # No CPython 3.10 build exists for Windows ARM64.
+          - runner: windows-11-arm
+            platform: windows
+            target: aarch64
+            pythons: "3.11 3.12 3.13 3.14 3.14t 3.15 3.15t"
+    env:
+      PYTHONS_OVERRIDE: ${{ matrix.pythons }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
+
+      - name: Install the interpreters
+        shell: bash
+        run: |
+          pythons="${PYTHONS_OVERRIDE:-$PYTHONS}"
+          echo "BUILD_PYTHONS=$pythons" >> "$GITHUB_ENV"
+          uv python install $pythons
+          paths=$(for v in $pythons; do uv python find --managed-python "$v"; done | tr '\\' '/' | tr '\n' ' ')
+          echo "$paths"
+          echo "INTERPRETERS=$paths" >> "$GITHUB_ENV"
+
+      - uses: dtolnay/rust-toolchain@39008827e6b4319a349e9a42dfc90579dd25f1ca # stable
+        with:
+          toolchain: stable
+
+      - uses: PyO3/maturin-action@e83996d129638aa358a18fbd1dfb82f0b0fb5d3b # v1.51.0
+        with:
+          target: ${{ matrix.target }}
+          args: --release --out dist --interpreter ${{ env.INTERPRETERS }}
+
+      - name: Test the wheels (every Python version)
+        shell: bash
+        run: bash .github/scripts/test-wheels.sh
+
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: dist-${{ matrix.platform }}-${{ matrix.target }}
+          path: dist
+
+  check:
+    name: Check the distributions
+    runs-on: ubuntu-latest
+    needs: [sdist, linux, macos-windows]
+    steps:
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          pattern: dist-*
+          merge-multiple: true
+          path: dist
+
+      - uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
+
+      - name: Check metadata and list the files
+        run: |
+          uvx twine check --strict dist/*
+          ls -l dist
+          echo "$(ls dist/*.whl | wc -l) wheels"
+
+  publish:
+    name: Publish to PyPI
+    if: startsWith(github.ref, 'refs/tags/v')
+    needs: check
+    runs-on: ubuntu-latest
+    environment:
+      name: pypi
+      url: https://pypi.org/project/dxf_io/
+    permissions:
+      id-token: write  # trusted publishing and attestations
+    steps:
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          pattern: dist-*
+          merge-multiple: true
+          path: dist
+
+      - uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086 # v1.14.3
+
+  github-release:
+    name: GitHub release
+    needs: publish
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          pattern: dist-*
+          merge-multiple: true
+          path: dist
+
+      - name: Create the release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
+        run: |
+          flags=""
+          case "$GITHUB_REF_NAME" in *[0-9]a[0-9]*|*[0-9]b[0-9]*|*rc*) flags="--prerelease" ;; esac
+          gh release create "$GITHUB_REF_NAME" dist/* --verify-tag --generate-notes $flags
